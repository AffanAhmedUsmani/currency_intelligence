# No API keys are required for the default providers (Frankfurter + Yahoo Finance
# chart endpoint are both free/keyless). These are here for configuration/tuning only.

CI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CI_CACHE_LATEST_TTL_SECONDS=300
CI_CACHE_HISTORICAL_TTL_SECONDS=3600
CI_HTTP_TIMEOUT_SECONDS=12
